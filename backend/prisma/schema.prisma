generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model GoogleAccount {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  googleId     String   @unique(map: "google_id_unique") @map("google_id") @db.VarChar(255)
  email        String   @db.VarChar(255)
  name         String?  @db.VarChar(255)
  picture      String?  @db.VarChar(512)
  accessToken  String?  @map("access_token") @db.VarChar(1024)
  refreshToken String?  @map("refresh_token") @db.VarChar(1024)
  role         String?  @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([userId], map: "idx_user_id")
  @@map("google_accounts")
}

model activity_log {
  id           Int      @id @default(autoincrement())
  actor_id     Int?
  actor_name   String?  @db.VarChar(255)
  actor_role   String?  @db.VarChar(100)
  action       String   @db.VarChar(100)
  entity_type  String   @db.VarChar(100)
  entity_id    Int?
  entity_label String?  @db.VarChar(255)
  summary      String   @db.Text
  details      String?  @db.Text
  created_at   DateTime @default(now()) @db.DateTime(0)

  @@index([created_at], map: "idx_activity_log_created_at")
  @@index([actor_id], map: "idx_activity_log_actor_id")
  @@index([entity_type, action], map: "idx_activity_log_entity")
}

model achievement {
  id          Int       @id @default(autoincrement())
  alumni_id   Int?
  title       String    @db.VarChar(255)
  category    String?   @db.VarChar(100)
  image       String?   @db.VarChar(255)
  description String?   @db.Text
  date        DateTime? @db.Date
  alumni      alumni?   @relation(fields: [alumni_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "achievement_ibfk_1")

  @@index([alumni_id], map: "alumni_id")
}

model alumni {
  id               Int                @id @default(autoincrement())
  user_id          Int?               @unique(map: "user_id")
  student_id       String?            @unique(map: "student_id") @db.VarChar(50)
  first_name       String             @db.VarChar(100)
  last_name        String             @db.VarChar(100)
  middle_name      String?            @db.VarChar(100)
  date_of_birth    DateTime?          @db.Date
  email            String?            @db.VarChar(255)
  contact_number   String?            @db.VarChar(50)
  // Educational level: College, High School, Senior High School
  level            alumni_level?
  // Batch/Year grouping (separate from graduation_year if needed)
  batch            Int?
  graduation_year  Int?
  course           String?            @db.VarChar(100)
  current_position String?            @db.VarChar(100)
  company          String?            @db.VarChar(100)
  location         String?            @db.VarChar(100)
  profile_image    String?            @db.VarChar(255)
  skills           String?            @db.Text
  bio              String?            @db.Text
  is_public        Boolean?           @default(true)
  is_student_id_public Boolean         @default(true)
  is_date_of_birth_public Boolean      @default(true)
  is_course_public     Boolean         @default(true)
  is_graduation_year_public Boolean    @default(true)
  is_education_history_public Boolean  @default(true)
  is_email_public      Boolean            @default(true)
  is_phone_public      Boolean            @default(true)
  is_position_public   Boolean            @default(true)
  is_company_public    Boolean            @default(true)
  is_employment_public Boolean            @default(true)
  is_location_public   Boolean            @default(true)
  is_social_links_public Boolean           @default(true)
  is_skills_public       Boolean           @default(true)
  is_verified      Boolean?           @default(false)
  status           String?            @default("LIVING") @db.VarChar(20)
  created_at       DateTime?          @default(now()) @db.DateTime(0)
  updated_at       DateTime?          @default(now()) @updatedAt @db.DateTime(0)
  achievement      achievement[]
  user             user?              @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "alumni_ibfk_1")
  career_entry     career_entry[]
  donation         donation[]
  event_attendance event_attendance[]
  social_link      social_link[]
  job_posting      job_posting[]
  batch_officer    batch_officer[]
  job_applications job_application[]
  deceased_reports deceased_report[] @relation("deceased_alumni")
  reports_submitted deceased_report[] @relation("reported_by_alumni")
}

model deceased_report {
  id                    Int       @id @default(autoincrement())
  alumni_id             Int
  reported_by_alumni_id Int?
  reason                String?   @db.Text
  evidence_file         String?   @db.VarChar(255)
  evidence_link         String?   @db.VarChar(512)
  status                String    @default("PENDING") @db.VarChar(20)
  admin_notes           String?   @db.Text
  created_at            DateTime  @default(now()) @db.DateTime(0)
  updated_at            DateTime  @default(now()) @updatedAt @db.DateTime(0)

  alumni                alumni    @relation("deceased_alumni", fields: [alumni_id], references: [id], onDelete: Cascade)
  reported_by           alumni?   @relation("reported_by_alumni", fields: [reported_by_alumni_id], references: [id], onDelete: SetNull)

  @@index([alumni_id])
  @@index([reported_by_alumni_id])
  @@index([status])
}

model career_entry {
  id          Int       @id @default(autoincrement())
  alumni_id   Int?
  company     String?   @db.VarChar(255)
  job_title   String?   @db.VarChar(255)
  start_date  DateTime? @db.Date
  end_date    DateTime? @db.Date
  description String?   @db.Text
  is_current  Boolean?  @default(false)
  alumni      alumni?   @relation(fields: [alumni_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "career_entry_ibfk_1")

  @@index([alumni_id], map: "alumni_id")
}

model job_posting {
  id                  Int       @id @default(autoincrement())
  posted_by_alumni_id Int?
  job_title           String    @db.VarChar(255)
  company             String    @db.VarChar(255)
  location            String?   @db.VarChar(255)
  department          String?   @db.VarChar(100)
  job_type            String?   @db.VarChar(50)
  salary_range        String?   @db.VarChar(100)
  requirements        String?   @db.Text
  benefits            String?   @db.Text
  description         String?   @db.Text
  application_url     String?   @db.VarChar(1000)
  application_deadline DateTime? @db.Date
  created_at          DateTime? @default(now()) @db.DateTime(0)
  updated_at          DateTime? @default(now()) @db.DateTime(0)
  alumni              alumni?   @relation(fields: [posted_by_alumni_id], references: [id], onDelete: SetNull)
  job_applications    job_application[]

  @@index([posted_by_alumni_id], map: "idx_posted_by")
}

model job_application {
  id               Int       @id @default(autoincrement())
  job_posting_id   Int
  applicant_id     Int
  cover_letter     String?   @db.Text
  resume_url       String?   @db.VarChar(255)
  status           application_status @default(PENDING)
  applied_at       DateTime  @default(now()) @db.DateTime(0)
  reviewed_at      DateTime? @db.DateTime(0)
  notes            String?   @db.Text
  job_posting      job_posting @relation(fields: [job_posting_id], references: [id], onDelete: Cascade)
  applicant        alumni      @relation(fields: [applicant_id], references: [id], onDelete: Cascade, map: "job_application_applicant")
  
  @@unique([job_posting_id, applicant_id], map: "unique_job_application")
  @@index([job_posting_id], map: "idx_job_posting")
  @@index([applicant_id], map: "idx_applicant")
}

enum application_status {
  PENDING
  REVIEWED
  SHORTLISTED
  REJECTED
  ACCEPTED
}

model donation {
  id              Int       @id @default(autoincrement())
  alumni_id       Int?
  amount          Decimal   @db.Decimal(10, 2)
  date            DateTime? @db.Date
  purpose         String?   @db.VarChar(255)
  description     String?   @db.Text
  image           String?   @db.VarChar(255)
  category        String?   @db.VarChar(100)
  goal            Decimal?  @db.Decimal(10, 2)
  donation_type   String?   @default("both") @db.VarChar(20)
  accepts_money   Boolean?  @default(true)
  accepts_items   Boolean?  @default(true)
  item_name       String?   @db.VarChar(255)
  item_description String?  @db.Text
  alumni          alumni?   @relation(fields: [alumni_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "donation_ibfk_1")
  donation_images donation_image[]
  receipt_submissions receipt_submission[]

  @@index([alumni_id], map: "alumni_id")
}

model donation_image {
  id          Int       @id @default(autoincrement())
  donation_id Int
  image_url   String    @db.VarChar(500)
  created_at  DateTime? @default(now()) @db.DateTime(0)
  donation    donation? @relation(fields: [donation_id], references: [id], onDelete: Cascade)

  @@index([donation_id])
}

model receipt_submission {
  id            Int       @id @default(autoincrement())
  campaign_id   Int
  admin_user_id Int
  submitted_at  DateTime  @default(now())
  status        String    @default("submitted") @db.VarChar(50)
  notes         String?   @db.Text
  campaign      donation? @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id])
}

model event {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(255)
  description      String?            @db.Text
  date             DateTime?          @db.Date
  end_date         DateTime?          @db.Date
  location         String?            @db.VarChar(255)
  image            String?            @db.VarChar(255)
  send_notification Boolean?          @default(false)
  status           event_status?      @default(UPCOMING)
  notified_current Boolean?           @default(false)
  target_batch     Int?
  created_at       DateTime?          @default(now()) @db.DateTime(0)
  updated_at       DateTime?          @default(now()) @db.DateTime(0)
  event_attendance event_attendance[]
  event_gallery    event_gallery[]
  notifications    notification[]
}

enum event_status {
  UPCOMING
  CURRENT
  PREVIOUS
}

model event_gallery {
  id          Int       @id @default(autoincrement())
  event_id    Int
  image       String    @db.VarChar(255)
  caption     String?   @db.Text
  uploaded_by Int?
  created_at  DateTime? @default(now()) @db.DateTime(0)
  event       event     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user        user?     @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)

  @@index([event_id], map: "idx_event_id")
  @@index([uploaded_by], map: "idx_uploaded_by")
}

model event_attendance {
  id            Int       @id @default(autoincrement())
  event_id      Int?
  alumni_id     Int?
  registered_at DateTime? @default(now()) @db.DateTime(0)
  attended      Boolean?  @default(false)
  event         event?    @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_attendance_ibfk_1")
  alumni        alumni?   @relation(fields: [alumni_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "event_attendance_ibfk_2")

  @@index([alumni_id], map: "alumni_id")
  @@index([event_id], map: "event_id")
}

model social_link {
  id        Int     @id @default(autoincrement())
  alumni_id Int?
  platform  String? @db.VarChar(100)
  url       String? @db.VarChar(255)
  alumni    alumni? @relation(fields: [alumni_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "social_link_ibfk_1")

  @@index([alumni_id], map: "alumni_id")
}

model user {
  id                      Int              @id @default(autoincrement())
  email                   String           @unique(map: "email") @db.VarChar(255)
  password                String?          @db.VarChar(255)
  username                String?          @db.VarChar(100)
  profile_image           String?          @db.VarChar(255)
  role                    user_role?       @default(ALUMNI)
  approval_status         approval_status? @default(PENDING)
  is_active               Boolean?         @default(false)
  is_blocked              Boolean?         @default(false)
  notification_enabled    Boolean?         @default(true)
  notification_prompt_shown Boolean?       @default(false)
  notify_events           Boolean?         @default(true)
  notify_achievements     Boolean?         @default(true)
  notify_donations        Boolean?         @default(true)
  notify_jobs             Boolean?         @default(true)
  show_donation_toasts    Boolean?         @default(true)
  notify_pending_registrations Boolean?    @default(true)
  notify_job_applications Boolean?        @default(true)
  created_at              DateTime?        @default(now()) @db.DateTime(0)
  updated_at              DateTime?        @default(now()) @db.DateTime(0)
  alumni                  alumni?
  event_gallery           event_gallery[]
  notifications           notification[]
}

enum notification_type {
  EVENT
  ACHIEVEMENT
  ANNOUNCEMENT
  GENERAL
  JOB_APPLICATION
  DONATION
}

enum user_role {
  ADMIN
  ALUMNI
  STAFF
}

enum approval_status {
  PENDING
  APPROVED
  REJECTED
}

// Alumni level classification
enum alumni_level {
  INTEGRATED_SCHOOL
  NIGHT_HIGH
  SENIOR_HIGH
  COLLEGE
  ETEEAP
  GRAD_SCHOOL
}

// New teacher table for managing teacher accounts separately from user/alumni
model teacher {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  username      String?   @db.VarChar(100)
  department    String?   @db.VarChar(100)
  password      String?   @db.VarChar(255)
  profile_image String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.DateTime(0)
  updated_at    DateTime? @default(now()) @db.DateTime(0)
}

model notification {
  id         Int       @id @default(autoincrement())
  user_id    Int
  event_id   Int?
  type       notification_type @default(GENERAL)
  title      String    @db.VarChar(255)
  message    String    @db.Text
  link       String?   @db.VarChar(255)
  sender_name String?  @db.VarChar(255)
  sender_profile_image String? @db.VarChar(255)
  is_read    Boolean   @default(false)
  created_at DateTime  @default(now()) @db.DateTime(0)
  user       user      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event      event?    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  
  @@index([user_id], map: "user_id")
  @@index([event_id], map: "idx_notification_event")
}

// Pending registrations table - holds registration requests until admin approval
model pending_registration {
  id                    Int            @id @default(autoincrement())
  email                 String         @unique @db.VarChar(255)
  password              String         @db.VarChar(255)
  username              String         @db.VarChar(100)
  first_name            String?        @db.VarChar(100)
  last_name             String?        @db.VarChar(100)
  student_id            String?        @db.VarChar(50)
  contact_number        String?        @db.VarChar(50)
  level                 alumni_level?
  course                String?        @db.VarChar(100)
  batch                 Int?
  graduation_year       Int?
  profile_image         String?        @db.VarChar(255)
  verification_document String?        @db.VarChar(255)
  additional_info       String?        @db.Text
  status                pending_status @default(PENDING)
  created_at            DateTime       @default(now()) @db.DateTime(0)
  updated_at            DateTime       @default(now()) @updatedAt @db.DateTime(0)
  rejected_reason       String?        @db.Text
}

enum pending_status {
  PENDING
  APPROVED
  REJECTED
}

model batch_officer {
  id         Int       @id @default(autoincrement())
  alumni_id  Int
  batch      Int
  position   String    @db.VarChar(100)
  term_start Int?
  term_end   Int?
  created_at DateTime  @default(now()) @db.DateTime(0)
  updated_at DateTime  @default(now()) @updatedAt @db.DateTime(0)
  alumni     alumni    @relation(fields: [alumni_id], references: [id], onDelete: Cascade)
  
  @@unique([alumni_id, batch, position], map: "unique_officer_position")
  @@index([batch], map: "idx_batch")
  @@index([alumni_id], map: "idx_alumni_officer")
}

model alumni_list {
  id              Int       @id @default(autoincrement())
  student_id      String    @unique @db.VarChar(50)
  first_name      String    @db.VarChar(100)
  last_name       String    @db.VarChar(100)
  middle_name     String?   @db.VarChar(100)
  course          String?   @db.VarChar(100)
  level           String?   @db.VarChar(50)
  batch           Int?
  graduation_year Int?
  status          String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, GRADUATED
  created_at      DateTime  @default(now()) @db.DateTime(0)
  updated_at      DateTime  @default(now()) @updatedAt @db.DateTime(0)
  
  @@index([student_id], map: "idx_student_id")
  @@index([batch], map: "idx_alumni_batch")
  @@index([graduation_year], map: "idx_graduation_year")
}
