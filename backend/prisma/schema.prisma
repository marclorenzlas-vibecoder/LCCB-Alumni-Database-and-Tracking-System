generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model GoogleAccount {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  googleId     String   @unique(map: "google_id_unique") @map("google_id")
  email        String
  name         String?
  picture      String?
  accessToken  String?  @map("access_token")
  refreshToken String?  @map("refresh_token")
  role         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@map("google_accounts")
}

model activity_log {
  id           Int      @id @default(autoincrement())
  actor_id     Int?
  actor_name   String?
  actor_role   String?
  action       String
  entity_type  String
  entity_id    Int?
  entity_label String?
  summary      String
  details      String?
  created_at   DateTime @default(now())

  @@index([created_at])
  @@index([actor_id])
  @@index([entity_type, action])
}

model achievement {
  id          Int       @id @default(autoincrement())
  alumni_id   Int?
  title       String
  category    String?
  image       String?
  description String?
  date        DateTime?
  alumni      alumni?   @relation(fields: [alumni_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([alumni_id])
}

model alumni {
  id                          Int                @id @default(autoincrement())
  user_id                     Int?               @unique(map: "user_id")
  student_id                  String?            @unique(map: "student_id")
  first_name                  String
  last_name                   String
  middle_name                 String?
  date_of_birth               DateTime?
  email                       String?
  contact_number              String?
  // Educational level: College, High School, Senior High School
  level                       alumni_level?
  // Batch/Year grouping (separate from graduation_year if needed)
  batch                       Int?
  graduation_year             Int?
  course                      String?
  current_position            String?
  company                     String?
  location                    String?
  profile_image               String?
  skills                      String?
  bio                         String?
  is_public                   Boolean?           @default(true)
  is_student_id_public        Boolean            @default(false)
  is_date_of_birth_public     Boolean            @default(false)
  is_course_public            Boolean            @default(true)
  is_graduation_year_public   Boolean            @default(true)
  is_education_history_public Boolean            @default(true)
  is_email_public             Boolean            @default(false)
  is_phone_public             Boolean            @default(false)
  is_position_public          Boolean            @default(false)
  is_company_public           Boolean            @default(false)
  is_employment_public        Boolean            @default(false)
  is_location_public          Boolean            @default(false)
  is_social_links_public      Boolean            @default(false)
  is_skills_public            Boolean            @default(false)
  is_verified                 Boolean?           @default(false)
  status                      String?            @default("LIVING")
  created_at                  DateTime?          @default(now())
  updated_at                  DateTime?          @default(now()) @updatedAt
  achievement                 achievement[]
  user                        user?              @relation(fields: [user_id], references: [id], onUpdate: Restrict)
  career_entry                career_entry[]
  donation                    donation[]
  event_attendance            event_attendance[]
  social_link                 social_link[]
  job_posting                 job_posting[]
  batch_officer               batch_officer[]
  job_applications            job_application[]
  deceased_reports            deceased_report[]  @relation("deceased_alumni")
  reports_submitted           deceased_report[]  @relation("reported_by_alumni")
}

model deceased_report {
  id                    Int      @id @default(autoincrement())
  alumni_id             Int
  reported_by_alumni_id Int?
  reason                String?
  evidence_file         String?
  evidence_link         String?
  status                String   @default("PENDING")
  admin_notes           String?
  created_at            DateTime @default(now())
  updated_at            DateTime @default(now()) @updatedAt

  alumni      alumni  @relation("deceased_alumni", fields: [alumni_id], references: [id], onDelete: Cascade)
  reported_by alumni? @relation("reported_by_alumni", fields: [reported_by_alumni_id], references: [id], onDelete: SetNull)

  @@index([alumni_id])
  @@index([reported_by_alumni_id])
  @@index([status])
}

model career_entry {
  id                Int       @id @default(autoincrement())
  alumni_id         Int?
  company           String?
  job_title         String?
  start_date        DateTime?
  end_date          DateTime?
  description       String?
  is_current        Boolean?  @default(false)
  program_alignment String?   @default("NEEDS_REVIEW")
  alignment_notes   String?
  alumni            alumni?   @relation(fields: [alumni_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([alumni_id])
}

model job_posting {
  id                   Int               @id @default(autoincrement())
  posted_by_alumni_id  Int?
  job_title            String
  company              String
  location             String?
  department           String?
  job_type             String?
  salary_range         String?
  requirements         String?
  benefits             String?
  description          String?
  application_url      String?
  application_deadline DateTime?
  created_at           DateTime?         @default(now())
  updated_at           DateTime?         @default(now())
  alumni               alumni?           @relation(fields: [posted_by_alumni_id], references: [id], onDelete: SetNull)
  job_applications     job_application[]

  @@index([posted_by_alumni_id])
}

model job_application {
  id             Int                @id @default(autoincrement())
  job_posting_id Int
  applicant_id   Int
  cover_letter   String?
  resume_url     String?
  status         application_status @default(PENDING)
  applied_at     DateTime           @default(now())
  reviewed_at    DateTime?
  notes          String?
  job_posting    job_posting        @relation(fields: [job_posting_id], references: [id], onDelete: Cascade)
  applicant      alumni             @relation(fields: [applicant_id], references: [id], onDelete: Cascade)

  @@unique([job_posting_id, applicant_id])
  @@index([job_posting_id])
  @@index([applicant_id])
}

enum application_status {
  PENDING
  REVIEWED
  SHORTLISTED
  REJECTED
  ACCEPTED
}

model donation {
  id                  Int                  @id @default(autoincrement())
  alumni_id           Int?
  amount              Decimal
  date                DateTime?
  purpose             String?
  description         String?
  image               String?
  category            String?
  goal                Decimal?
  donation_type       String?              @default("both")
  accepts_money       Boolean?             @default(true)
  accepts_items       Boolean?             @default(true)
  item_name           String?
  item_description    String?
  alumni              alumni?              @relation(fields: [alumni_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  donation_images     donation_image[]
  receipt_submissions receipt_submission[]

  @@index([alumni_id])
}

model donation_image {
  id          Int       @id @default(autoincrement())
  donation_id Int
  image_url   String
  created_at  DateTime? @default(now())
  donation    donation? @relation(fields: [donation_id], references: [id], onDelete: Cascade)

  @@index([donation_id])
}

model receipt_submission {
  id            Int       @id @default(autoincrement())
  campaign_id   Int
  admin_user_id Int
  submitted_at  DateTime  @default(now())
  status        String    @default("submitted")
  notes         String?
  campaign      donation? @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id])
}

model event {
  id                Int                @id @default(autoincrement())
  name              String
  description       String?
  date              DateTime?
  end_date          DateTime?
  location          String?
  image             String?
  send_notification Boolean?           @default(false)
  status            event_status?      @default(UPCOMING)
  notified_current  Boolean?           @default(false)
  target_batch      Int?
  created_at        DateTime?          @default(now())
  updated_at        DateTime?          @default(now())
  event_attendance  event_attendance[]
  event_gallery     event_gallery[]
  notifications     notification[]
}

enum event_status {
  UPCOMING
  CURRENT
  PREVIOUS
}

model event_gallery {
  id          Int       @id @default(autoincrement())
  event_id    Int
  image       String
  caption     String?
  uploaded_by Int?
  created_at  DateTime? @default(now())
  event       event     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user        user?     @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)

  @@index([event_id])
  @@index([uploaded_by])
}

model event_attendance {
  id            Int       @id @default(autoincrement())
  event_id      Int?
  alumni_id     Int?
  registered_at DateTime? @default(now())
  attended      Boolean?  @default(false)
  event         event?    @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  alumni        alumni?   @relation(fields: [alumni_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([alumni_id])
  @@index([event_id])
}

model social_link {
  id        Int     @id @default(autoincrement())
  alumni_id Int?
  platform  String?
  url       String?
  alumni    alumni? @relation(fields: [alumni_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([alumni_id])
}

model user {
  id                               Int              @id @default(autoincrement())
  email                            String           @unique(map: "email")
  password                         String?
  username                         String?
  profile_image                    String?
  role                             user_role?       @default(ALUMNI)
  approval_status                  approval_status? @default(PENDING)
  is_active                        Boolean?         @default(false)
  is_blocked                       Boolean?         @default(false)
  notification_enabled             Boolean?         @default(true)
  notification_prompt_shown        Boolean?         @default(false)
  notify_events                    Boolean?         @default(true)
  notify_achievements              Boolean?         @default(true)
  notify_donations                 Boolean?         @default(true)
  notify_jobs                      Boolean?         @default(true)
  show_donation_toasts             Boolean?         @default(true)
  birthday_notification_visibility String?          @default("PUBLIC")
  notify_pending_registrations     Boolean?         @default(true)
  notify_job_applications          Boolean?         @default(true)
  consent_core                     Boolean?         @default(false)
  consent_timestamp                DateTime?
  privacy_notice_version           String?
  created_at                       DateTime?        @default(now())
  updated_at                       DateTime?        @default(now())
  alumni                           alumni?
  event_gallery                    event_gallery[]
  notifications                    notification[]
}

enum notification_type {
  EVENT
  ACHIEVEMENT
  ANNOUNCEMENT
  GENERAL
  JOB_APPLICATION
  DONATION
}

enum user_role {
  ADMIN
  ALUMNI
  STAFF
}

enum approval_status {
  PENDING
  APPROVED
  REJECTED
}

// Alumni level classification
enum alumni_level {
  INTEGRATED_SCHOOL
  NIGHT_HIGH
  SENIOR_HIGH
  COLLEGE
  ETEEAP
  GRAD_SCHOOL
}

// New teacher table for managing teacher accounts separately from user/alumni
model teacher {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  username      String?
  department    String?
  password      String?
  profile_image String?
  created_at    DateTime? @default(now())
  updated_at    DateTime? @default(now())
}

model notification {
  id                   Int               @id @default(autoincrement())
  user_id              Int
  event_id             Int?
  type                 notification_type @default(GENERAL)
  title                String
  message              String
  link                 String?
  sender_name          String?
  sender_profile_image String?
  is_read              Boolean           @default(false)
  created_at           DateTime          @default(now())
  user                 user              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event                event?            @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([event_id])
}

// Pending registrations table - holds registration requests until admin approval
model pending_registration {
  id                     Int            @id @default(autoincrement())
  email                  String         @unique
  password               String
  username               String
  first_name             String?
  last_name              String?
  student_id             String?
  contact_number         String?
  level                  alumni_level?
  course                 String?
  batch                  Int?
  graduation_year        Int?
  profile_image          String?
  verification_document  String?
  additional_info        String?
  consent_core           Boolean        @default(false)
  consent_timestamp      DateTime?
  privacy_notice_version String?
  status                 pending_status @default(PENDING)
  created_at             DateTime       @default(now())
  updated_at             DateTime       @default(now()) @updatedAt
  rejected_reason        String?
}

enum pending_status {
  PENDING
  APPROVED
  REJECTED
}

model batch_officer {
  id         Int      @id @default(autoincrement())
  alumni_id  Int
  batch      Int
  position   String
  term_start Int?
  term_end   Int?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  alumni     alumni   @relation(fields: [alumni_id], references: [id], onDelete: Cascade)

  @@unique([alumni_id, batch, position])
  @@index([batch])
  @@index([alumni_id])
}

model alumni_list {
  id              Int      @id @default(autoincrement())
  student_id      String   @unique
  first_name      String
  last_name       String
  middle_name     String?
  course          String?
  level           String?
  batch           Int?
  graduation_year Int?
  status          String   @default("ACTIVE") // ACTIVE, GRADUATED
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt

  @@index([student_id])
  @@index([batch])
  @@index([graduation_year])
}

model chat_conversations {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chat_id           String              @unique
  status            String              @default("pending")
  requested_by      String?
  request_to        String?
  blocked_by        String?
  blocked_user      String?
  last_message      String?
  last_message_time DateTime?           @default(now()) @db.Timestamptz(6)
  last_sender_id    String?
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?           @default(now()) @db.Timestamptz(6)
  chat_messages     chat_messages[]
  chat_participants chat_participants[]
}

model chat_participants {
  chat_id            String
  user_id            String
  unread_count       Int?               @default(0)
  updated_at         DateTime?          @default(now()) @db.Timestamptz(6)
  chat_conversations chat_conversations @relation(fields: [chat_id], references: [chat_id], onDelete: Cascade)

  @@id([chat_id, user_id])
}

model chat_messages {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chat_id            String?
  sender_id          String
  receiver_id        String
  message            String
  type               String              @default("message")
  is_read            Boolean?            @default(false)
  created_at         DateTime?           @default(now()) @db.Timestamptz(6)
  chat_conversations chat_conversations? @relation(fields: [chat_id], references: [chat_id], onDelete: Cascade)
}

model profile_change_log {
  id         Int      @id @default(autoincrement())
  user_id    Int
  field_name String
  old_value  String?
  new_value  String?
  created_at DateTime @default(now())

  @@index([user_id])
  @@index([field_name])
  @@map("profile_change_logs")
}

