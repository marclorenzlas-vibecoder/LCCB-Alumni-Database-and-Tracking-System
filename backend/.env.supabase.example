# Copy these settings into backend/.env.development and replace all placeholders
# with credentials from your own Supabase project.
PORT=5001
FRONTEND_URL=http://localhost:3002
NODE_ENV=development
JWT_SECRET=your_jwt_secret_change_in_production
SESSION_SECRET=your_session_secret_change_in_production

# Supabase PostgreSQL connection strings
DATABASE_URL="your_supabase_pooler_connection_string"
DIRECT_URL="your_supabase_direct_connection_string"

# Supabase API keys (never expose the service-role key in frontend code)
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Optional Gemini AI
GEMINI_API_KEY=your_gemini_api_key
